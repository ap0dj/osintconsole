# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto eol=lf

# Explicitly text
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf

# Binary (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
